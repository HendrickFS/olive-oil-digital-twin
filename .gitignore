# Root .gitignore for digitalTwin repository

# Ignore mosquitto generated secrets in ditto deployment
/ditto/deployment/docker/certs/
/ditto/deployment/docker/passwd
/ditto/deployment/docker/*.srl
/ditto/deployment/docker/*.pem
/ditto/deployment/docker/server.key

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/
catboost_info/

# Java/Maven
target/
*.class

# Log files and CSV outputs
*.log
logs.txt
dataset-influx.csv
mixer_graphs/

# Node / build / IDE
node_modules/
dist/
.DS_Store
.idea/
.vscode/

